generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String          @id @default(uuid())
  name       String          @unique
  spread     Decimal
  exchanges  UserExchange[]

  @@map("users")
}

model Currency {
  code         String          @id
  currencyName String
  exchanges    UserExchange[]

  @@map("currencies")
}

model UserExchange {
  id                       String   @id @default(uuid())
  userId                   String
  destinationCurrencyCode  String
  quantity                 Decimal
  unitPriceBrl             Decimal
  totalPriceBrl            Decimal
  datetime                 DateTime @default(now())
  clientQuoteId            String   @unique

  user     User     @relation(fields: [userId], references: [id])
  currency Currency @relation(fields: [destinationCurrencyCode], references: [code])

  @@map("users_exchanges")
}
